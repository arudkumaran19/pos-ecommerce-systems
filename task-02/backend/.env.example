# Task 02 Environment Configuration
ENVIRONMENT=development
DEBUG=True

# Database (Independent PostgreSQL for Task 02)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/task02_ecommerce

# Security & Sessions
SESSION_SECRET=task02-super-secret-random-key-with-high-entropy-64-chars-long-minimum-length
SESSION_COOKIE_NAME=task02_session
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_SAMESITE=lax
SESSION_MAX_AGE_SECONDS=604800

# Commerce & Concurrency
RESERVATION_TTL_SECONDS=300
SWEEPER_INTERVAL_SECONDS=15

# Media Uploads
MEDIA_DIR=media/avatars
MAX_UPLOAD_SIZE_BYTES=2097152

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
